# Gemini AI API Key (Injected automatically in AI Studio, or set manually for production)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
APP_URL="MY_APP_URL"

# Server Port (3000 for AI Studio dev server, 8000 for standalone backend)
PORT="3000"

# JWT Secret for Session Signing
JWT_SECRET="lumen_interview_studio_secure_jwt_secret_change_in_production"

# MySQL Database Configuration (Optional: Lumen uses an embedded ACID persistent store when MySQL is not configured)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="lumen_user"
MYSQL_PASSWORD="lumen_password"
MYSQL_DATABASE="lumen_ai_interview"
